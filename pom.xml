<?xml version="1.0"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.brunobat</groupId>
    <artifactId>quarkus-lab</artifactId>
    <packaging>pom</packaging>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <!-- Aligned Quarkus platform version for all modules. Override locally in a module
             (e.g. uncomment its 999-SNAPSHOT line) for manual testing. -->
        <quarkus.platform.version>3.40.1</quarkus.platform.version>
        <!-- Shared compiler config for all modules; override locally if a module needs it. -->
        <compiler-plugin.version>3.16.0</compiler-plugin.version>
        <maven.compiler.release>21</maven.compiler.release>
        <surefire-plugin.version>3.6.0</surefire-plugin.version>
        <!-- ITs are skipped by default for all modules; each module's native profile re-enables them. -->
        <skipITs>true</skipITs>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- Quarkus BOM coordinates. group-id is left per-module (it varies: io.quarkus vs
             io.quarkus.platform); this is only a default so the import below resolves here. -->
        <quarkus.platform.group-id>io.quarkus</quarkus.platform.group-id>
        <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>${quarkus.platform.artifact-id}</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <modules>
        <module>otel-metrics-docs</module>
        <module>otel-metrics</module>
        <module>otel-metrics-lgtm</module>
        <module>otel-aws</module>
        <module>otel-aws-rosa</module>
        <module>otel-logs</module>
        <module>micrometer-lgtm</module>
        <module>micrometer-filters</module>
        <module>micrometer-custom-metric-lgtm</module>
        <module>micrometer-prometheus</module>
        <module>otel-tracing</module>
        <module>micrometer-otel</module>
        <module>micrometer-otel-2-exporters</module>
        <module>micrometer-otel-bootui</module>
        <module>otel-fault-tolerance</module>
        <module>micrometer-otel-langchain4j</module>
        <module>otel-reactive-routes</module>
        <module>micrometer-prometheus-multi-registry</module>
        <module>otel-all-kube</module>
        <module>otel-mutiny</module>
        <module>otel-mcp-grafana</module>
        <module>otel-mcp-server</module>
        <module>otel-mcp-client</module>
    </modules>
</project>